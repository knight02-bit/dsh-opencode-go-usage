{
  "name": "dsh-opencode-go-usage",
  "version": "0.1.0",
  "description": "在 DSH（DeepSeek Harness）底部实时显示 OpenCode Go 的 rolling / weekly / monthly 剩余额度百分比，并可浮出配速卡",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "scripts/check-dock.cjs"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "opencode",
    "opencode-go",
    "usage",
    "quota",
    "status-bar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knight02-bit/dsh-opencode-go-usage.git"
  },
  "homepage": "https://github.com/knight02-bit/dsh-opencode-go-usage#readme",
  "bugs": {
    "url": "https://github.com/knight02-bit/dsh-opencode-go-usage/issues"
  },
  "license": "MIT",
  "author": "knight02-bit",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check-dock.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
